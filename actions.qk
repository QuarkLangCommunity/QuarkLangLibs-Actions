/* QuarkLang 官方库：actions —— 进程/网络执行动作（官方认证，纯 qk 实现）
 *
 * 两级结构（全部为 QuarkLang 语言特性，无任何扩展语法）：
 *   第一级 space 系统级普通函数：system / network
 *   第二级 包装类：Command / Network 是 struct+impl，实现 Executor 接口；
 *          new(参数) 构造，实例方法 .exec() 执行 —— Command::new(params).exec()
 *
 * 安全约束（运行时强制）：
 *   - execv 走 argv 直传（不经 shell，注入面为零）；exec/popen 经 sh -c；
 *   - popen 输出 ≤ 8 MiB；network::get/post 10s 超时、响应 ≤ 8 MiB。
 */
program library;

// ===== 第一级：space 系统级普通函数 =====
space {
    // 执行 shell 命令，返回退出码（0=成功）
    fn exec(String cmd) int {
        return qkexec(cmd);
    }
    // argv 直传，不经 shell（无注入面），返回退出码
    fn execv(String prog, List<String> args) int {
        return qkexecv(prog, args);
    }
    // 捕获命令 stdout 为输入流
    fn popen(String cmd) InputStream {
        return qkpopen(cmd);
    }
} system;

space {
    // HTTP GET，返回响应体（10s 超时，8 MiB 上限）
    fn get(String url) String {
        return qkhttp_get(url);
    }
    // HTTP POST(url, body, contentType)，返回响应体
    fn post(String url, String body, String contentType) String {
        return qkhttp_post(url, body, contentType);
    }
} network;

// ===== 第二级：包装类（实现 Executor 接口，new(参数) 构造 + .exec()） =====
type interface {
    fn exec(Self self) int;
} Executor;

type struct {
    String prog;
    List<String> args;
} Command;

impl {
    // 构造：Command::new(prog, args) —— 命令由参数构成
    fn new(String prog, List<String> args) Command {
        Command c;
        c.prog = prog;
        c.args = args;
        return c;
    }
    // 实现 Executor：执行构造时指定的命令（argv 直传，无 shell 注入面）
    fn exec(Command self) int {
        return system::execv(self.prog, self.args);
    }
} Command;

type struct {
    String url;
} Network;

impl {
    // 构造：Network::new(url) —— 面向指定地址
    fn new(String url) Network {
        Network n;
        n.url = url;
        return n;
    }
    // 实现 Executor：对构造地址执行网络命令（GET），失败抛错、成功 0
    fn exec(Network self) int {
        network::get(self.url);
        return 0;
    }
    // GET 响应体
    fn get(Network self) String {
        return network::get(self.url);
    }
} Network;
