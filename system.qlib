/* QuarkLang 官方库：system —— 系统进程执行（官方认证）
 *
 * 认证说明：本库是 QuarkLang 官方认证的 system 库——它所包装的
 * qkexec/qkexecv/qkpopen 原语由 QuarkLang 运行时（interp）提供，
 * 本文件是官方给出的使用形态与语义背书。
 *
 * 安全约束（运行时强制）：
 *   - qkexec/qkpopen 经 shell 执行（sh -c）；如需完全避免 shell 注入，
 *     使用 execv（argv 直传，不经 shell）。
 *   - qkpopen 输出上限 8 MiB，超限直接报错。
 */
program library;

pub fn exec(cmd String) int {
    return qkexec(cmd);
}

pub fn execv(prog String, args List<String>) int {
    return qkexecv(prog, args);
}

pub fn popen(cmd String) InputStream {
    return qkpopen(cmd);
}
